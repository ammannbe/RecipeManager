APP_NAME=RecipeManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

SANCTUM_STATEFUL_DOMAINS=localhost:3000

LOCALE=en
# Leave empty to hide the language switcher:
LOCALES=en,de

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# This option enabled can blow up your log channel:
LOG_QUERIES=false
TELEGRAM_LOGGER_BOT_TOKEN=
TELEGRAM_LOGGER_CHAT_ID=

# Comma separated list of IP Addresses:
TRUSTED_PROXIES="172.16.238.0/24"

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=recipe_manager
DB_USERNAME=recipe_manager
DB_PASSWORD=recipe_manager

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Remember to fit these settings also in your frontend
DISABLE_REGISTRATION=false
DISABLE_COOKBOOKS=false
DISABLE_TAGS=false
DISABLE_RATINGS=false
DISABLE_UNIT_CREATION=false
DISABLE_FOOD_CREATION=false
DISABLE_INGREDIENT_ATTRIBUTE_CREATION=false
MAX_RATING_STARS=5
